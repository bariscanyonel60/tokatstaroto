# Yayın adresi (canonical, sitemap, Open Graph ve yapılandırılmış veri için)
NEXT_PUBLIC_SITE_URL=https://alanadiniz.com

# İletişim formu (e-posta ile iletim — Resend API).
# Bu değişkenler tanımlı değilse form "etkin değil" yanıtı verir ve başarılı gönderim SİMÜLE EDİLMEZ.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Resend üzerinde doğrulanmış bir gönderici adresi, örn: "Star Oto Market <form@alanadiniz.com>"
CONTACT_FROM_EMAIL=
